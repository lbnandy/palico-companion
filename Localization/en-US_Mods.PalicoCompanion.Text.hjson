		From enemies hit by you or your Palico: {0} chance of 1 extra item per stackable drop
		Vanilla boss materials yield an average of {1} extra
		Excludes Treasure Bags, equipment, valuables and statue-spawned enemies
		'''
	MiningKit:
		'''
		Your Palico mines {0} faster
		{1}-tile increase to its ore detection, digging assistance and pickaxe reach
		Does not increase pickaxe power
		'''
	GardenKit:
		'''
		You and your Palico gather an average of {0} more wood and {1} more herbs
		Your Palico gains {2} fishing power
		Does not increase seeds, gems or furniture drops
		'''
	ExpandedBelt:
		'''
		Permanently adds one Palico support slot
		Can only be used once
		'''
	ImprovedTools:
		'''
		Permanently upgrades Palico support and work gear to the Improved tier
		Requires the Reinforced Toolkit first
		'''
	MasterTools:
		'''
		Permanently upgrades Palico support and work gear to the Masterwork tier
		Requires the Improved Toolkit first
		'''
	CatWorkbench:
		'''
		Used to craft Palico gear and upgrades
		Right-click to open the Palico Guide
		'''
}

CompanionBarrelCharge: {
	Landing: Landing to prepare a barrel charge
	NoRoute: Needs a nearby ground enemy and a safe route
	Busy: Barrel charge in progress
}
