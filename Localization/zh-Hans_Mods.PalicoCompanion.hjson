UI: {
	NameEmpty: 请输入名字，再确认
	DefaultName: 呆猫
	DyeSlot: 染料
	DyeHint: 同时为呆猫、风筝和状态卡头像染色
	SortBag: 整理物品
	SortDone: 背包整理好了
	SortUnavailable: 暂时无法整理，请稍后重试
	PetCloser: 靠近呆猫就能摸摸了
	PetHappy: 嘿嘿，好舒服喵～
	HudStowed: 已收起
	HudRecovering: 恢复中
	HudWorking: 工作中
	HudFishing: 钓鱼中
	HudCombat: 战斗中
	HudDelivering: 送补给
	HudHint: 点击打开呆猫背包
	Stowed: 呆猫已收起
	CallOut: 叫出来
	RecallAction: 召回
	Stow: 暂时收起
	RecoveryWait: 呆猫正在恢复，稍等它回来
	Tiles: 格
	AppearanceMeetTitle: 认识你的呆猫
	AppearanceName: 名字
	AppearanceLater: 稍后设置
	AppearanceStart: 一起出发
	AppearanceTitle: 名字与配色
	AppearanceReset: 恢复原色
	AppearanceCancel: 取消
	AppearanceConfirm: 确定
	AppearanceHue: 色相
	AppearanceSaturation: 饱和度
	AppearanceLightness: 亮度
	AppearanceEntry: 名字与配色
	GardenWalking: 去照料开花的药草
	GardenWorking: 正在收获、补种
	GardenDone: 药草已采收并补种
	GardenReplantBlocked: 药草已采收，当前位置暂时无法补种
	GardenBlocked: 暂时无法采收，种子未消耗
	QuickStack: 快捷堆叠
	NativeBagHint: 面板打开时，玩家或箱子中的 Shift 点击会转入呆猫背包；收藏物品不会快捷转移。
	Transferred: 转移了 {0} 件物品
	Recovering: 正在恢复，{0} 秒后回来帮忙
	GearHint: 投掷武器可整叠装备；弹药放入呆猫背包
	DefaultWeaponHint: 空栏时自带铜短剑
	CannonStagesHint: 呆猫使用能量弹攻击，暂不使用最后的持续光束
	RecoverArmor: 取回
	LegacyArmorHint: 旧版防具仅供取回，防御现在随玩家成长
	Weapon: 武器
	HealthHint: 呆猫的生命上限为玩家的 75%
	ManaHint: 呆猫的法力上限与玩家相同，至少为 20；独立消耗和恢复。缺蓝且没有可用蓝药时，回满后继续施法
	DefenseHint: 呆猫的防御为玩家的 75%
	HealthLabel: 生命
	ManaLabel: 法力
	MinionSlots: 仆从位
	SentrySlots: 哨兵位
	SentrySlotsHint: 已放置 / 自动布置上限。上限与玩家相同，至少为 1，不占用玩家的哨兵位。战斗转移时重新布置。撒旦军队武器沿用原版解锁条件，事件中消耗呆猫背包里的天国魔力。
	MinionSlotsHint: 已占用 / 上限。上限与玩家相同，至少为 1，不占用玩家的仆从位；部分召唤物会占用多个或不足一个位置。
	Defense: 防御
	StorageLinked: 老大，这个箱子我也可以用了喵！
	StorageUnlinked: 已撤销此箱子的使用许可
	ChestSupplyOn: 允许呆猫使用：是
	ChestSupplyOff: 允许呆猫使用：否
	ChestSupplyLinkHint:
		'''
		点击允许呆猫使用这个箱子，可以同时允许多个箱子。
		你在附近且箱子关闭时，存入同类战利品，并按需补充药水、当前武器弹药及工作消耗品。
		不取收藏物品；许可随角色保存，各世界分别记忆。
		'''
	ChestSupplyUnlinkHint: 撤销此箱子的使用许可
	ChestSupplyDisabledHint: 已关闭箱子补给。可在模组设置中开启“使用获准的箱子”。
	StorageWalking: 前往补给箱
	StorageWorking: 存放物品并补充消耗品
	StorageBlocked: 暂时无法到达补给箱，稍后重试
	StorageDone: 已存入 {0} 件物品，补充 {1} 件消耗品
	Required: 需要
	Available: 持有
	Following: 跟随主人
	Guarding: 警戒中
	VeinOn: 矿脉：最多 12 块
	VeinOff: 采矿：单块
	BagTab: 背包
	WorkTab: 工作
	CompanionTab: 呆猫
	PausedState: 已暂停
	RestState: 休息中
	MineTarget: 选择矿块
	BuildTarget: 选择施工起点，再确认材料用量
	TargetHint: 左键选择场景位置 · 右键 / Esc 取消
	Left: 向左平台
	Right: 向右平台
	Down: 向下绳索
	Length: 长度
	Preview: 选择起点
	Confirm: 确认施工
	Progress: 施工进度
	NoOrder: 暂无施工任务
	WorkHint: 先放入材料，再选择起点；确认后开始施工。预览不会改变地形。
	Recall: 召回
	Pet: 摸摸
	Take: 全部取回
}

Projectiles: {
	CompanionCat.DisplayName: 呆猫
	TrainingBomb.DisplayName: 呆猫爆弹
	TrainingDart.DisplayName: 贯通回旋镖
}

CoinChoices: {
	Owner: 给主人
	Bank: 存入小猪存钱罐
	Bag: 留在呆猫背包
}

Configs: {
	CompanionConfig: {
		Headers: {
			Companion: "[palicohead:icon] 陪伴与战斗"
			Work: "[palicoitem:GoldPickaxe] 采集与探索"
			Building: "[palicoitem:Torch] 照明与施工"
			Deliveries: "[palicoitem:GoldCoin] 递交给玩家"
			Restocking: "[palicoitem:Chest] 箱子补给与储备"
			Display: "[palicoitem:Goggles] 界面与提示"
			Advanced: "[palicoitem:Wrench] 其他选项"
		}

		ShareNewPickups: {
			Label: 递交新拾取的物品
			Tooltip: 靠近你时，将新捡的物品补入你已有的堆叠；你仍可使用的生命水晶等会优先递交。先留下呆猫需要的补给，不递交手动放入或收藏的物品。
		}

		CoinDestination: {
			Label: 新拾取的钱币去向
			Tooltip: 只处理呆猫新捡的钱币，不移动你原有的钱币。小猪存钱罐装不下的余款留在呆猫背包；装备钱币枪时会保留弹药。
		}

		StockTorches: {
			Label: 火把储备数量
			Tooltip: 呆猫可用存量低于目标约三分之一时，从获准的箱子补足。设为 0 时不主动补充，已有物品仍可使用；收藏物品不计入存量，也不会被消耗。
		}

		StockGlowsticks: {
			Label: 荧光棒储备数量
			Tooltip: 呆猫可用存量低于目标约三分之一时，从获准的箱子补足。设为 0 时不主动补充，已有物品仍可使用；收藏物品不计入存量，也不会被消耗。
		}

		StockPlatforms: {
			Label: 木平台储备数量
			Tooltip: 呆猫可用存量低于目标约三分之一时，从获准的箱子补足。设为 0 时不主动补充，已有物品仍可使用；收藏物品不计入存量，也不会被消耗。
		}

		StockRopes: {
			Label: 绳索储备数量
			Tooltip: 呆猫可用存量低于目标约三分之一时，从获准的箱子补足。设为 0 时不主动补充，已有物品仍可使用；收藏物品不计入存量，也不会被消耗。
		}

		StockHealing: {
			Label: 治疗药水储备数量
			Tooltip: 呆猫可用存量低于目标约三分之一时，从获准的箱子补足。设为 0 时不主动补充，已有物品仍可使用；收藏物品不计入存量，也不会被消耗。
		}

		StockMana: {
			Label: 魔力药水储备数量
			Tooltip: 呆猫可用存量低于目标约三分之一时，从获准的箱子补足。设为 0 时不主动补充，已有物品仍可使用；收藏物品不计入存量，也不会被消耗。
		}

		StockAmmo: {
			Label: 弹药储备数量
			Tooltip: 用于当前武器的弹药和投掷物。开启 「更好的体验」 无限弹药或投掷物时，优先将正在使用的一种补到无限门槛；否则低于目标约三分之一时补足。设为 0 不主动补充。只取获准储物中的未收藏物品。
		}

		StockAcorns: {
			Label: 橡实储备数量
			Tooltip: 呆猫可用存量低于目标约三分之一时，从获准的箱子补足。设为 0 时不主动补充，已有物品仍可使用；收藏物品不计入存量，也不会被消耗。
		}

		StockBait: {
			Label: 鱼饵储备数量
			Tooltip: 呆猫可用存量低于目标约三分之一时，从获准的箱子补足。设为 0 时不主动补充，已有物品仍可使用；收藏物品不计入存量，也不会被消耗。
		}

		CatSounds: {
			Label: 播放猫叫声
			Tooltip: 在说话、受伤、抚摸等情境播放猫叫，避免连续重复。
		}

		Fishing: {
			Label: 自动钓鱼
			Tooltip: 在水边逗留或你开始钓鱼时，呆猫会寻找钓点。需要呆猫背包中未收藏的鱼饵，可参考你携带的更好鱼竿；不使用松露虫，不钓起敌人。
		}

		DeliverRecoveryDrops: {
			Label: 递送红心和魔力星
			Tooltip: 你需要恢复生命或法力时，呆猫把附近掉落的红心或魔力星送给你。不消耗背包物品。
		}

		CatchCritters: {
			Label: 自动捕捉小动物
			Tooltip: 使用基础网兜，或参考你背包里更高级的网兜。避开放生的小动物、雕像生成的生物和指路仙灵。
		}

		RunInBackground: {
			Label: 切换窗口后继续游戏
			Tooltip: 单人游戏失去焦点时仍然运行。原版菜单暂停和背包自动暂停照常生效。
		}

		Ropes: {
			Label: 协助铺设绳索
			Tooltip: 连续铺绳索时帮忙延长，下行时接长绳索；在落差边缘按住向下键可开始铺绳。使用你或呆猫背包中未收藏的绳索。此选项随当前角色保存，新角色默认关闭。
		}

		AutoHeal: {
			Label: 自动喝药
			Tooltip: 呆猫生命不高于一半时喝治疗药水，施法时法力不足则喝魔力药水。消耗呆猫背包中未收藏的药水；药水冷却与魔力病独立于玩家。
		}

		Chatter: {
			Label: 在聊天栏显示呆猫台词
			Tooltip: 包含探索提醒、工作结果和日常闲聊；优先显示重要消息，合并重复的工作结果。
		}

		Discoveries: {
			Label: 提示附近的重要发现
			Tooltip: 提示 16 格内的生命水晶、生命果、宝箱、世纪之花花苞和受困 NPC，不受地形遮挡。同一目标不会反复提示，也不会自动开启或采集。
		}

		Emotes: {
			Label: 显示表情气泡
			Tooltip: 在呆猫头顶显示喝药、抚摸、休息等情境的表情。
		}

		Gardening: {
			Label: 自动采收药草
			Tooltip: 采收附近开花的药草，未开花的不动。有可用种子时补种；没有种子也能采收。收藏的种子不会被消耗。
		}

		CompanionHud: {
			Label: 显示左上角状态卡
			Tooltip: 在增益图标下方显示生命、状态和装备冷却。点击可打开呆猫背包；打开物品栏或全屏地图时隐藏。
		}

		ShowActivityStatus: {
			Label: 显示背包内的工作详情
			Tooltip: 在呆猫背包底部显示当前任务和操作结果。只改变显示，不影响工作、聊天或左上角状态卡。
		}

		CompanionMarker: {
			Label: 显示位置标记
			Tooltip: 在地图上显示呆猫头像；呆猫在画面外时显示方向和距离。收起后隐藏。
		}

		Enabled: {
			Label: 启用呆猫
			Tooltip: 关闭呆猫功能，保留物品、名字和成长进度。临时离队可使用背包底部的“暂时收起”。
		}

		AdvancedOrders: {
			Label: 显示手动工作页（单人）
			Tooltip: 在呆猫背包增加手动选矿、预览施工和取消任务的页面。日常自动工作不需要开启；多人模式不显示此页。
		}

		Forestry: {
			Label: 自动砍树
			Tooltip: 采伐附近成熟树木，有合适的橡实和位置时补种。没有橡实也能砍树；保留幼苗及树干有住房墙或促动器的装饰树。你主动砍伐时也会协助。
		}

		DiggingAssist: {
			Label: 协助玩家挖掘
			Tooltip: 沿你挥镐的方向接着挖，也支持竖直向下挖掘。使用当前可用的镐力；停手后最多继续约 8 秒，离开或改做其他事情时停止。打开呆猫背包不会中断协助。
		}

		MiningBlacklist: {
			Label: 不挖的物块
			Tooltip: 选择对应的矿石、宝石或方块物品。呆猫会跳过这些物块，仍可正常拾取它们的掉落物。只影响自己的呆猫。
		}

		PickupBlacklist: {
			Label: 不捡的物品
			Tooltip: 呆猫不会追逐、吸取或搬运所选物品。不会影响玩家拾取，也不会禁止箱子补给。只影响自己的呆猫。
		}

		MiningAssist: {
			Label: 自动采矿
			Tooltip: 空闲或慢速探索时寻找附近露出的矿石和宝石。参考你背包里最强的镐，未携带时用基础镐；镐力不足的矿物暂不挖掘。
		}

		DisplayName: 呆猫伙伴设置

		Pickup: {
			Label: 自动拾取
			Tooltip: 吸取附近能装入呆猫背包的普通掉落物。带有特殊拾取效果的模组物品留给玩家。递交物品与钱币去向可在下方另行设置。
		}

		Combat: {
			Label: 自动战斗
			Tooltip: 呆猫使用装备的武器攻击敌人；武器格为空时使用铜短剑。关闭后仍会跟随和工作。
		}

		Torches: {
			Label: 自动照明
			Tooltip: 陆地优先使用火把，水下或缺少火把时使用荧光棒。使用你或呆猫背包中未收藏的物品；放置火把才消耗，手持照明不消耗。
		}

		Bridges: {
			Label: 协助铺设平台
			Tooltip: 连续铺设平台时帮忙延长，也会填补前方同高度、六格内有对岸的小缺口。优先用呆猫背包的材料，再用你的非收藏木平台。此选项随当前角色保存，新角色默认关闭。
		}

		AutoLogistics: {
			Label: 使用获准的箱子
			Tooltip: 你在附近、箱子未被打开时，呆猫存入同类物品并补充消耗品。先打开箱子，点击旁边的猫头像授予许可；可以允许多个箱子。
		}

		TrainingHints: {
			Label: 提示装备与成长机会
			Tooltip: 提醒制作工作台、装备支援／工作装备和使用升级道具。每条提示只出现一次；完整配方随时可在呆猫指南查看。
		}
	}

	CoinDestinationMode: {
		// Tooltip: ""
		// Owner.Tooltip: ""
		// Bank.Tooltip: ""
		// Bag.Tooltip: ""
	}
}

MemoryTwins: 双子魔眼

Speech: {
	BossEventGoblin: {
		Line1: 老大，哥布林都跑到咱们这儿来了喵！
		Line2: 他们怎么还带刺球的喵……老大，小心脚下！
		Line3: 来这么多也没用，老大还有我喵！
	}

	BossEventSnowman: {
		Line1: 老大，雪人拿着枪喵！这和我堆的不是一种吧？
		Line2: 补药开枪喵！……老大，我躲你旁边一下。
		Line3: 我堆的雪人怎么就不会帮忙打怪喵……
	}

	BossEventPirate: {
		Line1: 老大，海盗上岸了喵！咱们的东西不能给他们。
		Line2: 他们的鸟也来打架喵？老大，看上边！
		Line3: 老大，他们是来抢东西的，咱们能抢回去吗喵？
	}

	BossEventMartian: {
		Line1: 老大，天上那些家伙飞过来了喵！小心那道光！
		Line2: 老大，他们坐着飞碟来的喵！咱们打下来一架好不好？
		Line3: 喵？！这是什么怪物？老大，你认识吗？
	}

	BossEventBloodMoon: {
		Line1: 老大，月亮红了喵……今晚我跟紧点。
		Line2: 老大，外面闹成这样，今晚还睡不睡了喵？
		Line3: 连月亮都红了……老大，我陪你守夜喵。
	}

	BossEventEclipse: {
		Line1: 老大，天怎么突然黑了喵？……那些家伙可不像来睡觉的！
		Line2: 明明是白天，怎么出来这么多怪家伙喵！
		Line3: 老大，太阳没了喵！刚才还在的！
	}

	BossEventPumpkinMoon: {
		Line1: 老大，南瓜怎么会追着人跑喵！窝以后还吃不吃南瓜了……
		Line2: 老大，我只会摘南瓜，不会摘这种喵！
		Line3: 老大，那个南瓜在看我们喵……它还笑！
	}

	BossEventFrostMoon: {
		Line1: 老大，礼物盒在动喵！谁家礼物还会自己跑啊？
		Line2: 老大，树也来打架了喵！斧头能管用吗？
		Line3: 这跟说好的过节不一样喵！
	}

	BossEventArmy: {
		Line1: 老大，他们冲水晶来了喵！窝也来守！
		Line2: 老大，水晶旁边又来一群喵！我也去帮忙！
		Line3: 想砸老大的水晶？先过我这关喵！
	}

	BossEventSlimeRain: {
		Line1: 老大，下的不是雨，是史莱姆喵！
		Line2: 天上掉果冻了喵……不对，不能吃！
		Line3: 老大，小心头上喵！今天的雨会跳！
	}

	BossEventPillars: {
		Line1: 老大，这根柱子旁边好多怪家伙喵……咱们一起过去。
		Line2: 老大，这柱子是从哪儿冒出来的喵？
		Line3: 老大，这边我没来过……你可别把我落下喵。
	}

	RestEventQuiet: {
		Line1: 老大，打完了……窝饿啦喵。
		Line2: 老大，给我看看，有没有伤到哪儿喵？
		Line3: 终于安静了喵。刚才喊老大都快听不见了。
	}

	OwnerHurtDeath: {
		Line1: 老大？……我看着东西，等你回来喵。
		Line2: 老大……这次没护住你喵。
		Line3: 老大，你回来咱们再打它喵……
	}

	WelcomeRevived: {
		Line1: 老大！你回来啦喵，我刚才好担心。
		Line2: 老大！让我看看，真的没事了喵？
		Line3: 回来就好喵……刚才我都不知道怎么办了。
	}

	WorkingBagFull: {
		Line1: 老大，包满啦，装不下了喵！
		Line2: 装不进去喵……老大，帮我腾点地方吧。
		Line3: 包都撑圆了喵……可窝还想捡！
	}

	DeliveredUpgrade: {
		Line1: 老大，这个能让你更厉害，给你喵！
		Line2: 窝捡到好东西啦，老大快收好喵！
		Line3: 老大，这个留给你喵，快收好！
	}

	LootPlunder: {
		Line1: 老大，多摸到一份{0}，赚啦喵！
		Line2: 嘿嘿，还藏着{0}，被窝找到啦喵！
		Line3: 老大，多一份{0}喵！嘿嘿，赚到啦。
	}

	BossRematchSlimeKing: {
		Line1: 老大，大果冻又来了喵！
		Line2: 又戴着皇冠来打架了喵。它是不是不服气？
		Line3: 老大，这个咱们打赢过！不过它还是好大一坨喵。
	}

	BossRematchEye: {
		Line1: 老大，又是那个大眼珠子喵！窝认得它。
		Line2: 老大，就是它，上回打着打着长了嘴喵！
		Line3: 又瞪我喵？老大，我们再打它一次！
	}

	BossRematchEater: {
		Line1: 老大，那条长虫又钻出来了喵！
		Line2: 这条虫咱们打过喵。打完一截，后面还有一大截！
		Line3: 老大，脚底下又响了喵……是上回那种长虫！
	}

	BossRematchBrain: {
		Line1: 老大，又是那个光长脑子的喵！
		Line2: 那些小眼睛又来帮忙了喵。老大，我也来！
		Line3: 又是它喵！上回变出那么多个，哪有这样打架的！
	}

	BossRematchBee: {
		Line1: 老大，又是那只大蜜蜂喵！窝这回也没偷吃蜂蜜。
		Line2: 还没看见就听见了喵。老大，是那只大蜜蜂！
		Line3: 老大，又要打蜂王了喵？打完能分我点蜂蜜吗？
	}

	BossRematchSkeletron: {
		Line1: 老大，又是那个大骷髅喵！两只手也都还在。
		Line2: 老大，上回散成那样，它又拼回来了喵？
		Line3: 又是它喵！没身子还这么能打。
	}

	BossRematchDeerclops: {
		Line1: 老大，又是那只独眼怪喵！个头一点没小。
		Line2: 老大，地上冒冰的那个又来了喵！
		Line3: 上回咱们打赢它了喵，老大，这次也带我一个！
	}

	BossRematchWall: {
		Line1: 老大，那堵会动的墙又来了喵！咱们边跑边打！
		Line2: 老大，还是那堵墙喵！这回也不让人往回走。
		Line3: 老大，又要跑那么远喵？等我一起！
	}

	BossRematchQueenSlime: {
		Line1: 老大，又是亮晶晶的史莱姆喵！它还会飞来着。
		Line2: 老大，我记得它会飞喵！可别只看地上。
		Line3: 皇后又来了喵。打输了还要再来，跟老大一样。
	}

	BossRematchTwins: {
		Line1: 老大，那两只铁眼睛又来了喵！
		Line2: 老大，又是一个喷火、一个射激光喵！它们就不能一个一个来吗？
		Line3: 这两只咱们打过喵！老大，今天还拆不拆？
	}

	BossRematchDestroyer: {
		Line1: 老大，铁皮长虫又来了喵！
		Line2: 老大，它还带着那些会飞的小眼睛喵！
		Line3: 老大，我听见它从底下钻过来了喵！跟上回一样！
	}

	BossRematchPrime: {
		Line1: 老大，又是那个好多手的骷髅喵！
		Line2: 老大，它的锯子又响了喵！听着就牙酸。
		Line3: 这个铁骷髅咱们赢过喵！这回也一起把它拆了。
	}

	BossRematchPlantera: {
		Line1: 老大，那朵会追人的花又来了喵！
		Line2: 这朵花咱们打过喵。待会儿它还要更凶的！
		Line3: 老大，这回又是谁敲的花苞喵？
	}

	BossRematchGolem: {
		Line1: 老大，又是庙里那个大石头喵！
		Line2: 上回头都打掉了还在打喵。老大，这个可得打到底。
		Line3: 老大，又来拆庙里的大石头了喵？
	}

	BossRematchDuke: {
		Line1: 老大，又是那条长翅膀的大鱼喵！
		Line2: 又是那条鱼喵！老大，这回还喂它松露虫吗？
		Line3: 老大，咱们赢过它喵！不过它冲过来还是好快！
	}

	BossRematchEmpress: {
		Line1: 老大，漂亮的那位又来了喵！就是打人特别疼的那位。
		Line2: 又是满天的光喵……老大，上回我都快找不着你了。
		Line3: 老大，我认得她喵！上次我们一起打赢的！
